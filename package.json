{
  "name": "switchboard-desktop",
  "version": "0.9.4",
  "private": true,
  "author": "Switchboard contributors",
  "license": "MIT",
  "homepage": "https://github.com/sachin6174/switchboard",
  "repository": "github:sachin6174/switchboard",
  "description": "A local desktop app (Windows, macOS, Linux) for ChatGPT, Claude accounts, Claude API, the Gemini API Antigravity agent, and switching coding-CLI accounts with aiswitch",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "dist": "npm run build && node scripts/package-win.cjs",
    "test": "tsx --test tests/*.test.ts",
    "dist:win": "npm run build && node scripts/package-win.cjs",
    "dist:mac": "npm run build && node scripts/package-mac.cjs",
    "dist:linux": "node scripts/package-linux.cjs",
    "release": "node scripts/release.cjs",
    "release:upload": "node scripts/release.cjs --upload"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "local.switchboard.desktop",
    "productName": "Switchboard",
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/claude*",
      "node_modules/node-pty/**",
      "tools/aiswitch/**"
    ],
    "files": [
      "dist/**/*",
      "tools/aiswitch/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "sign": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Switchboard contributors",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  }
}
